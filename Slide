.navbtn{border:1px solid #cbd7e8;background:#fff;color:var(--blue);border-radius:999px;padding:10px 17px;cursor:pointer;box-shadow:0 4px 14px #173e7b12;font-size:14px}
.navbtn:disabled{opacity:.35;cursor:not-allowed}
.navbtn.next{background:var(--blue);color:#fff;border-color:var(--blue)}
.counter{font-size:13px;color:var(--muted);background:#fff;padding:8px 12px;border-radius:99px;border:1px solid var(--line)}
.progress{position:absolute;z-index:9;top:0;left:0;height:5px;background:var(--orange);width:0;transition:width .3s}
.decor{position:absolute;bottom:90px;right:5%;display:flex;gap:8px;opacity:.35;pointer-events:none}
