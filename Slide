.footer-topic{font-size:clamp(10px,1vw,13px);font-weight:bold;letter-spacing:.06em;text-transform:uppercase;color:var(--blue);overflow:hidden;text-overflow:ellipsis;white-space:nowrap}
.logo{width:92px;max-height:38px;object-fit:contain}
.controls{position:absolute;z-index:8;bottom:76px;left:0;right:0;display:flex;justify-content:space-between;align-items:center;padding:0 clamp(20px,4vw,58px);pointer-events:none}
