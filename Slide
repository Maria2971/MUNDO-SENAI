 let index=0;
 function show(n){
   index=Math.max(0,Math.min(slides.length-1,n));
   slides.forEach((s,i)=>{s.classList.toggle('active',i===index);s.setAttribute('aria-hidden',i===index?'false':'true')});
   prev.disabled=index===0;next.disabled=index===slides.length-1;
   counter.textContent=(index+1)+' / '+slides.length;
   progress.style.width=((index+1)/slides.length*100)+'%';
   topic.textContent=slides[index].dataset.topic||'Mundo SENAI 2026';
   document.querySelectorAll('.quiz').forEach(q=>{q.querySelectorAll('.option').forEach(b=>{b.classList.remove('correct','wrong');b.disabled=false});let f=q.querySelector('.feedback');if(f)f.textContent=''});
 }
 prev.addEventListener('click',()=>show(index-1));next.addEventListener('click',()=>show(index+1));
 document.addEventListener('keydown',e=>{
   if(e.key==='ArrowRight'||e.key==='PageDown'||e.key===' '){if(e.target.isContentEditable)return;e.preventDefault();show(index+1)}
   if(e.key==='ArrowLeft'||e.key==='PageUp'){e.preventDefault();show(index-1)}
   if(e.key==='Home')show(0);if(e.key==='End')show(slides.length-1);
 });
 // Tap/click near screen edges on touch devices to navigate.
 let startX=null;
 document.getElementById('deck').addEventListener('touchstart',e=>{startX=e.changedTouches[0].clientX},{passive:true});
 document.getElementById('deck').addEventListener('touchend',e=>{
   if(startX===null)return;const dx=e.changedTouches[0].clientX-startX;
   if(Math.abs(dx)>70){show(index+(dx<0?1:-1));startX=null;return}
   const x=e.changedTouches[0].clientX,w=window.innerWidth;
   if(x<w*.08)show(index-1);else if(x>w*.92)show(index+1);startX=null;
 },{passive:true});
 document.querySelectorAll('.quiz').forEach(q=>{
   const options=[...q.querySelectorAll('.option')],feedback=q.querySelector('.feedback');
   options.forEach((btn,i)=>btn.addEventListener('click',()=>{
     options.forEach((b,j)=>{b.disabled=true;b.classList.toggle('correct',j===Number(q.dataset.answer));b.classList.toggle('wrong',j===i&&j!==Number(q.dataset.answer))});
     feedback.textContent=(i===Number(q.dataset.answer)?'Correto! ':'Não foi dessa vez. ')+(q.dataset.explain||'');
   }));
 });
 show(0);
})();
</script>
</body>
</html>
