.grid.three{grid-template-columns:repeat(3,minmax(0,1fr))}
.panel{background:rgba(255,255,255,.92);border:1px solid var(--line);border-radius:18px;padding:clamp(17px,2vw,26px);box-shadow:0 8px 24px rgba(23,71,158,.055);position:relative;overflow:hidden}
.panel:before{content:"";position:absolute;left:0;top:0;bottom:0;width:4px;background:var(--orange)}
.panel p:last-child{margin-bottom:0}
