.topline{display:flex;align-items:center;gap:10px;color:var(--blue);font-size:clamp(11px,1vw,14px);font-weight:700;letter-spacing:.12em;text-transform:uppercase;margin-bottom:clamp(16px,3vh,30px)}
.topline:before{content:"";display:block;width:28px;height:4px;background:var(--orange)}
