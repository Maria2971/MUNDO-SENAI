h3{font-size:clamp(17px,1.65vw,23px);line-height:1.35;color:var(--blue);margin-bottom:10px}
p,li{font-size:clamp(16px,1.5vw,21px);line-height:1.55}
.lead{font-size:clamp(19px,2vw,28px);line-height:1.55;max-width:850px;color:#36465e}
.small{font-size:clamp(12px,1vw,15px);color:var(--muted);line-height:1.5}
.accent{color:var(--orange)}
