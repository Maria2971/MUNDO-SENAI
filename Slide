.callout{border-left:5px solid var(--orange);background:#fff5f0;padding:15px 20px;border-radius:0 12px 12px 0;max-width:1000px}
.flow{display:flex;align-items:stretch;gap:10px;flex-wrap:wrap;max-width:1100px}
.flow div{flex:1 1 130px;text-align:center;padding:18px 12px;border:1px solid var(--line);background:#fff;border-radius:14px;font-size:clamp(14px,1.3vw,18px);line-height:1.45}
